# The Movie Database (TMDB) API Credentials
# Get your API key or Bearer Read Access Token from: https://www.themoviedb.org/settings/api

# Option A: API Key (v3 auth - recommended for simple setups)
TMDB_API_KEY=your_tmdb_api_key_here

# Option B: API Read Access Token (v4 Bearer auth) - optional
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=cineml_db

# Google OAuth & Authentication
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
JWT_SECRET=your_jwt_secret_key_here